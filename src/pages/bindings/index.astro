---
import Page from '../../layouts/Page.astro';
import { AAC, REPO_URL, renderDocument } from '../../lib/aac';

const { Content } = await renderDocument(AAC.current, 'BINDINGS');
---

<Page title="Bindings" description="How an AAC contract travels through AGC, spec kernels and tickets, orchestrators and CI.">
  <p class="source-note">
    Rendered from <a href={`${REPO_URL}/blob/${AAC.current}/BINDINGS.md`}>BINDINGS.md at {AAC.current}</a>.
  </p>
  <article class="prose">
    <Content />
  </article>
</Page>
