---
import Page from '../../layouts/Page.astro';
import { AAC, REPO_URL, renderDocument } from '../../lib/aac';

const { Content } = await renderDocument(AAC.current, 'EVIDENCE');
---

<Page title="Evidence" description="The measurement behind each AAC rule, and the landscape.">
  <p class="source-note">
    Rendered from <a href={`${REPO_URL}/blob/${AAC.current}/EVIDENCE.md`}>EVIDENCE.md at {AAC.current}</a>.
  </p>
  <article class="prose">
    <Content />
  </article>
</Page>
